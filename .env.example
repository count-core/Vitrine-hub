# ---- Datenbank ----
DATABASE_URL=postgres://stamp:stamp@127.0.0.1:5432/stamp_hub
# Migrationen beim Start ausführen (Produktion). Lokal alternativ: pnpm db:migrate
RUN_MIGRATIONS=false

# ---- Auth ----
# Mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 48`
BETTER_AUTH_SECRET=bitte-durch-32-zufaellige-zeichen-ersetzen
BETTER_AUTH_URL=http://localhost:3000
# Offene Registrierung. Nach dem Anlegen der Konten auf false setzen, dann geht Registrieren nur per Einladungslink.
ALLOW_SIGNUP=true

# ---- Bilder ----
UPLOAD_DIR=./data/uploads

# ---- KI (Server-Standard, pro Sammlung in den Einstellungen überschreibbar) ----
# gemini oder ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Google-Suche in der KI-Schätzung (braucht Gemini mit Abrechnung, im Free Tier gesperrt)
GEMINI_GROUNDING=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Eigener Schlüssel zum Verschlüsseln der in der App hinterlegten API-Keys (sonst BETTER_AUTH_SECRET)
AI_KEY_SECRET=

# ---- Öffentliche Seiten ----
# Name der Installation (Titel, PWA)
APP_NAME=Vitrine-Hub
# Link zum Quellcode im Footer (leer = kein Link)
REPO_URL=https://github.com/count-core/Vitrine-hub
# Impressum und Datenschutz: Betreiberangaben. Ohne LEGAL_NAME zeigen die Seiten einen Platzhalter.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
