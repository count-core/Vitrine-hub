{
  "name": "vitrine-hub",
  "version": "0.1.0-beta.1",
  "description": "Self-hosted web app for stamp and coin collections with AI-assisted capture, statistics, price research and optional public showcase.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/count-core/Vitrine-hub"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx @better-auth/cli@latest generate --config server/utils/auth.ts --output server/db/auth-schema.ts -y",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "check": "pnpm typecheck && pnpm test",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@nuxt/ui": "^4.11.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.134",
    "@types/node": "^26.6.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver",
      "better-sqlite3"
    ]
  }
}
